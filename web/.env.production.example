# Plantilla del .env de PRODUCCIÓN para Hostinger (ver DEPLOY.md).
# Copia este archivo como .env en el servidor y llena los valores marcados con <...>.
# NUNCA subas el .env real al repositorio.

APP_NAME="Antojería Pingüin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_DISPLAY_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Base de datos MySQL creada en hPanel → Bases de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_pinguin>
DB_USERNAME=<u123456789_pinguin>
DB_PASSWORD=<contraseña de la base de datos>

# Sesiones y caché en la base de datos (no hay Redis en hosting compartido)
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Días que dura la sesión de la app de meseros (en minutos). 43200 = 30 días.
SANCTUM_TOKEN_EXPIRATION=43200

MAIL_MAILER=log
