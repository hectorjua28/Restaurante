{
  "name": "pinguin-meseros",
  "version": "0.0.1",
  "author": "Antojería Pingüin",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"src/**/*.{ts,html,scss}\"",
    "test": "npm run test:unit",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build:android": "ng build --configuration production && npx cap sync android",
    "icons": "php scripts/generate-icons.php"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@capacitor/cli": "8.6.2",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "description": "App de meseros de Antojería Pingüin"
}
